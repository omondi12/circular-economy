# index.html changes on every deploy but keeps the same URL - never let
# browsers/proxies cache it, so a plain reload always picks up the
# latest version instead of getting stuck on a stale copy.
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # /assets/* filenames are content-hashed by the build (e.g.
  # index-AbC123.js) - a new deploy always ships a new filename, so
  # these are safe to cache aggressively.
  <FilesMatch "\.(js|css|woff2?|svg|png|jpe?g|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
